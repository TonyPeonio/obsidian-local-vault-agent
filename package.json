{
  "name": "local-vault-agent",
  "version": "0.3.0",
  "description": "Search, compile and edit your notes with a fully local AI agent powered by Ollama. Every change is shown as a diff for approval before it is written.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=cjs --outfile=.e2e/e2e.cjs --log-level=warning && node .e2e/e2e.cjs",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "ollama",
    "ai",
    "agent",
    "local"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "diff": "^8.0.4"
  }
}
